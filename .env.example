# Database (see docker-compose.yml)
# DATABASE_URL: least-privileged app role, RLS-enforced at runtime (ADR-006).
# DIRECT_DATABASE_URL: schema-owning role, used only by `prisma migrate` (bypasses RLS).
DATABASE_URL="postgresql://proquado_app:proquado_app_dev_only@localhost:5433/proquado?schema=public"
DIRECT_DATABASE_URL="postgresql://proquado:proquado_dev_only@localhost:5433/proquado?schema=public"

# Auth.js
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# OIDC Provider (Keycloak local dev — see docker-compose.yml + infra/keycloak)
OIDC_ISSUER="http://localhost:8081/realms/proquado"
OIDC_CLIENT_ID="proquado-web"
OIDC_CLIENT_SECRET="proquado_dev_client_secret"

# Object Storage (MinIO local dev)
S3_ENDPOINT="http://localhost:9010"
S3_REGION="us-east-1"
S3_BUCKET="proquado-documents"
S3_ACCESS_KEY_ID="proquado"
S3_SECRET_ACCESS_KEY="proquado_dev_only"
S3_FORCE_PATH_STYLE="true"

# Release Token signing (HMAC secret — see docs/06_OFFLINE_SYNC_CONFLICT.md)
RELEASE_TOKEN_SECRET="replace-with-openssl-rand-base64-32"

# Observability
LOG_LEVEL="info"
SERVER_NODE_ID="local-dev"

NODE_ENV="development"

# Malware-Scanner (MASTERPROMPT Kap. 16, docs/10 Phase 7).
# "clamav" verlangt eine erreichbare clamd-Instanz; "stub" meldet immer CLEAN
# und wird in NODE_ENV=production abgelehnt. Ohne Wert: Entwicklung bekommt
# den Stub mit Warnung, Produktion einen harten Fehler.
#
# Lokal echt scannen:  docker compose up -d clamav   (dauert beim ersten Start
# ein paar Minuten — clamd lädt erst seine Signaturen) und dann hier
# MALWARE_SCANNER="clamav" setzen. Ob es wirklich läuft, sagt
# GET /api/health/ready unter checks.malwareScanner — nicht der Containerstatus.
MALWARE_SCANNER="stub"
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT="3310"
CLAMAV_TIMEOUT_MS="30000"
