// ProQuaDo — Prisma Schema
// Phase 1: Identity & Organization + Audit/Outbox Foundation
// See docs/02_DOMAIN_MODEL.md for the full target domain model.
// Later phases add Projects, Documents, Production Planning/Execution, Quality.

generator client {
  provider = "prisma-client-js"
}

// `url` is used by the generated Client at runtime and MUST point at the
// least-privileged `proquado_app` role (RLS-restricted, see ADR-006 and
// migration 20260808151300_rls_and_audit_hardening). `directUrl` is used by
// `prisma migrate`/`prisma db push` and MUST point at the schema-owning role,
// which bypasses RLS by default (required to create tables/policies at all).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Identity & Organization
// ─────────────────────────────────────────────────────────────

model Organization {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  version     Int      @default(1)

  sites                  Site[]
  departments            Department[]
  workCenters            WorkCenter[]
  users                  User[]
  employees              Employee[]
  roles                  Role[]
  permissions            Permission[]
  userRoles              UserRole[]
  rolePermissions        RolePermission[]
  qualifications         Qualification[]
  employeeQualifications EmployeeQualification[]
  delegations            Delegation[]
  auditEvents            AuditEvent[]
  outboxEvents           OutboxEvent[]

  customers                 Customer[]
  projects                  Project[]
  projectMembers            ProjectMember[]
  products                  Product[]
  assemblies                Assembly[]
  parts                     Part[]
  documents                 Document[]
  documentRevisions         DocumentRevision[]
  documentApprovals         DocumentApproval[]
  productionPlans           ProductionPlan[]
  productionPlanRevisions   ProductionPlanRevision[]
  planSteps                 PlanStep[]
  planStepDependencies      PlanStepDependency[]
  stepDocumentBindings      StepDocumentBinding[]
  checklistItems            ChecklistItem[]
  inspectionCharacteristics InspectionCharacteristic[]
  photoRequirements         PhotoRequirement[]

  productionOrders      ProductionOrder[]
  orderAssignments      OrderAssignment[]
  workStepInstances     WorkStepInstance[]
  workStepReleases      WorkStepRelease[]
  completionSubmissions CompletionSubmission[]
  stepConfirmations     StepConfirmation[]
  checklistResponses    ChecklistResponse[]
  measurementResults    MeasurementResult[]
  photoEvidence         PhotoEvidence[]
  secondApprovals       SecondApproval[]

  @@map("organizations")
}

model Site {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  code           String
  name           String
  location       String?
  timezone       String   @default("UTC")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  version        Int      @default(1)

  organization     Organization      @relation(fields: [organizationId], references: [id])
  departments      Department[]
  employees        Employee[]
  projects         Project[]
  productionOrders ProductionOrder[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("sites")
}

model Department {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  siteId         String   @map("site_id")
  name           String
  code           String?
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  version        Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id])
  site         Site         @relation(fields: [siteId], references: [id])
  workCenters  WorkCenter[]
  employees    Employee[]
  planSteps    PlanStep[]

  @@index([organizationId])
  @@index([siteId])
  @@map("departments")
}

model WorkCenter {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  departmentId   String   @map("department_id")
  name           String
  description    String?
  equipmentRef   String?  @map("equipment_ref")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  version        Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id])
  department   Department   @relation(fields: [departmentId], references: [id])
  planSteps    PlanStep[]

  @@index([organizationId])
  @@index([departmentId])
  @@map("work_centers")
}

model User {
  id                  String   @id @default(uuid())
  organizationId      String   @map("organization_id")
  externalId          String   @map("external_id") // subject claim from OIDC provider
  email               String
  displayName         String?  @map("display_name")
  isActive            Boolean  @default(true) @map("is_active")
  mfaRequired         Boolean  @default(false) @map("mfa_required")
  // Scrypt hash of the confirmation PIN used for step-up confirmation of
  // critical actions (ADR-005: "PIN + Audit-Trail für MVP"). Never the PIN
  // itself, never reversible — see src/lib/auth/confirmation-pin.ts. Null
  // means the user has not set a PIN and therefore cannot confirm steps.
  confirmationPinHash String?  @map("confirmation_pin_hash")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  version             Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee?
  userRoles    UserRole[]
  devices      Device[]
  sessions     Session[]

  delegationsGiven    Delegation[] @relation("DelegatingUser")
  delegationsReceived Delegation[] @relation("DelegatedUser")

  projectMemberships ProjectMember[]
  documentApprovals  DocumentApproval[]
  orderAssignments   OrderAssignment[]

  @@unique([organizationId, externalId])
  @@index([organizationId])
  @@map("users")
}

model Device {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  deviceLabel String?   @map("device_label")
  isRevoked   Boolean   @default(false) @map("is_revoked")
  lastSeenAt  DateTime? @map("last_seen_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("devices")
}

model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  deviceId  String?   @map("device_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model Employee {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @unique @map("user_id")
  employeeNumber String   @map("employee_number")
  departmentId   String?  @map("department_id")
  siteId         String?  @map("site_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  version        Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  site         Site?        @relation(fields: [siteId], references: [id])

  qualifications EmployeeQualification[]

  @@unique([organizationId, employeeNumber])
  @@index([organizationId])
  @@map("employees")
}

model Role {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  code           String // ADMIN, QUALITY_MANAGER, PROJECT_LEAD, PRODUCTION_MANAGER, WORKER, INSPECTOR, AUDITOR
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  version        Int      @default(1)

  organization    Organization     @relation(fields: [organizationId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  code           String // e.g. "document.release"
  name           String
  resource       String // e.g. "document"
  action         String // e.g. "release"
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  version        Int      @default(1)

  organization    Organization     @relation(fields: [organizationId], references: [id])
  rolePermissions RolePermission[]

  @@unique([organizationId, code])
  @@unique([organizationId, resource, action])
  @@index([organizationId])
  @@map("permissions")
}

model UserRole {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  roleId         String    @map("role_id")
  assignedAt     DateTime  @default(now()) @map("assigned_at")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  version        Int       @default(1)

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId, roleId])
  @@index([organizationId])
  @@index([userId])
  @@map("user_roles")
}

model RolePermission {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  roleId         String   @map("role_id")
  permissionId   String   @map("permission_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])
  permission   Permission   @relation(fields: [permissionId], references: [id])

  @@unique([organizationId, roleId, permissionId])
  @@index([organizationId])
  @@map("role_permissions")
}

model Qualification {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  code           String
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  version        Int      @default(1)

  organization           Organization            @relation(fields: [organizationId], references: [id])
  employeeQualifications EmployeeQualification[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("qualifications")
}

model EmployeeQualification {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  employeeId      String    @map("employee_id")
  qualificationId String    @map("qualification_id")
  certifiedAt     DateTime  @map("certified_at")
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  version         Int       @default(1)

  organization  Organization  @relation(fields: [organizationId], references: [id])
  employee      Employee      @relation(fields: [employeeId], references: [id])
  qualification Qualification @relation(fields: [qualificationId], references: [id])

  @@index([organizationId])
  @@index([employeeId])
  @@index([qualificationId, expiresAt])
  @@map("employee_qualifications")
}

model Delegation {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  delegatingUserId String   @map("delegating_user_id")
  delegatedUserId  String   @map("delegated_user_id")
  scopeType        String?  @map("scope_type") // ROLE, PERMISSION, QUALIFICATION
  scopeId          String?  @map("scope_id")
  reason           String
  startsAt         DateTime @map("starts_at")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  version          Int      @default(1)

  organization   Organization @relation(fields: [organizationId], references: [id])
  delegatingUser User         @relation("DelegatingUser", fields: [delegatingUserId], references: [id])
  delegatedUser  User         @relation("DelegatedUser", fields: [delegatedUserId], references: [id])

  @@index([organizationId])
  @@map("delegations")
}

// ─────────────────────────────────────────────────────────────
// Audit Trail (append-only) & Transactional Outbox
// ─────────────────────────────────────────────────────────────

model AuditEvent {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  correlationId    String?   @map("correlation_id")
  actorId          String?   @map("actor_id")
  delegatedActorId String?   @map("delegated_actor_id")
  eventType        String    @map("event_type") // e.g. "work_step.started"
  resourceType     String    @map("resource_type")
  resourceId       String?   @map("resource_id")
  previousValues   Json?     @map("previous_values")
  newValues        Json?     @map("new_values")
  reason           String?
  source           String? // web, mobile, api, import
  deviceId         String?   @map("device_id")
  clientTimestamp  DateTime? @map("client_timestamp")
  serverTimestamp  DateTime  @default(now()) @map("server_timestamp")
  result           String? // SUCCESS, FAILURE, PARTIAL
  failureReason    String?   @map("failure_reason")
  requestId        String?   @map("request_id")
  idempotencyKey   String?   @map("idempotency_key")
  createdAt        DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, resourceType, resourceId])
  @@index([organizationId, serverTimestamp])
  @@index([correlationId])
  @@map("audit_events")
}

model OutboxEvent {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  aggregateType  String    @map("aggregate_type")
  aggregateId    String    @map("aggregate_id")
  eventType      String    @map("event_type")
  payload        Json
  createdAt      DateTime  @default(now()) @map("created_at")
  processedAt    DateTime? @map("processed_at")
  processed      Boolean   @default(false)
  retryCount     Int       @default(0) @map("retry_count")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, processed])
  @@map("outbox_events")
}

// ─────────────────────────────────────────────────────────────
// Projects & Products (Phase 2)
// ─────────────────────────────────────────────────────────────

model Customer {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  customerNumber String   @map("customer_number")
  name           String
  email          String?
  phone          String?
  address        String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  version        Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id])
  projects     Project[]

  @@unique([organizationId, customerNumber])
  @@index([organizationId])
  @@map("customers")
}

// Status machine: DRAFT → ACTIVE → COMPLETED, with ON_HOLD/CANCELLED/ARCHIVED
// side states — see src/domain/projects/project-status.ts.
model Project {
  id                  String    @id @default(uuid())
  organizationId      String    @map("organization_id")
  siteId              String    @map("site_id")
  projectNumber       String    @map("project_number")
  name                String
  customerId          String    @map("customer_id")
  customerOrderNumber String?   @map("customer_order_number")
  description         String?
  status              String    @default("DRAFT")
  priority            Int       @default(3)
  plannedStartDate    DateTime? @map("planned_start_date") @db.Date
  plannedEndDate      DateTime? @map("planned_end_date") @db.Date
  // Audit-adjacent reference, deliberately not a Prisma relation — same
  // pattern as AuditEvent.actorId (see src/lib/audit/write-audit-event.ts):
  // avoids forcing a back-relation array onto User for every "created by"
  // column in the schema, and survives user anonymization cleanly.
  createdById         String    @map("created_by_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  version             Int       @default(1)

  organization Organization @relation(fields: [organizationId], references: [id])
  site         Site         @relation(fields: [siteId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])

  members          ProjectMember[]
  products         Product[]
  documents        Document[]
  productionPlans  ProductionPlan[]
  productionOrders ProductionOrder[]

  @@unique([organizationId, projectNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("projects")
}

model ProjectMember {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  projectId      String   @map("project_id")
  userId         String   @map("user_id")
  role           String? // free-text label, e.g. 'PROJECT_MANAGER' — RBAC is enforced via user_roles, not this field
  assignedAt     DateTime @default(now()) @map("assigned_at")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  project      Project      @relation(fields: [projectId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, projectId, userId])
  @@index([organizationId])
  @@index([projectId])
  @@map("project_members")
}

model Product {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  projectId      String   @map("project_id")
  productNumber  String   @map("product_number")
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  version        Int      @default(1)

  organization     Organization      @relation(fields: [organizationId], references: [id])
  project          Project           @relation(fields: [projectId], references: [id])
  assemblies       Assembly[]
  productionPlans  ProductionPlan[]
  productionOrders ProductionOrder[]

  @@unique([organizationId, productNumber])
  @@index([organizationId])
  @@index([projectId])
  @@map("products")
}

model Assembly {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  productId        String   @map("product_id")
  assemblyNumber   String   @map("assembly_number")
  name             String
  description      String?
  parentAssemblyId String?  @map("parent_assembly_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  version          Int      @default(1)

  organization    Organization @relation(fields: [organizationId], references: [id])
  product         Product      @relation(fields: [productId], references: [id])
  parentAssembly  Assembly?    @relation("AssemblyHierarchy", fields: [parentAssemblyId], references: [id])
  childAssemblies Assembly[]   @relation("AssemblyHierarchy")

  @@index([organizationId])
  @@index([productId])
  @@map("assemblies")
}

model Part {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  partNumber     String   @map("part_number")
  name           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  version        Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, partNumber])
  @@index([organizationId])
  @@map("parts")
}

// ─────────────────────────────────────────────────────────────
// Documents & Revisions (Phase 2)
// ─────────────────────────────────────────────────────────────

model Document {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  projectId      String   @map("project_id")
  documentNumber String   @map("document_number")
  title          String
  category       String? // 'DRAWING', 'INSTRUCTION', 'SPECIFICATION', 'CHECKLIST', ...
  department     String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  version        Int      @default(1)

  organization Organization          @relation(fields: [organizationId], references: [id])
  project      Project               @relation(fields: [projectId], references: [id])
  revisions    DocumentRevision[]
  stepBindings StepDocumentBinding[]

  @@unique([organizationId, documentNumber])
  @@index([organizationId])
  @@index([projectId])
  @@map("documents")
}

// Status machine: DRAFT → IN_REVIEW → APPROVED → RELEASED → SUPERSEDED |
// WITHDRAWN → ARCHIVED. See docs/03_STATE_MACHINES.md "Document Revision
// Status Machine" and src/domain/documents/document-status.ts. Once
// RELEASED, a revision is immutable — see Geschäftsgrundsatz 5/6.
model DocumentRevision {
  id                String    @id @default(uuid())
  organizationId    String    @map("organization_id")
  documentId        String    @map("document_id")
  revisionNumber    String    @map("revision_number") // '01', '02', ...
  status            String    @default("DRAFT")
  title             String
  description       String?
  changeReason      String?   @map("change_reason")
  mimeType          String?   @map("mime_type")
  fileSizeBytes     BigInt?   @map("file_size_bytes")
  fileHashSha256    String?   @map("file_hash_sha256")
  storageKey        String?   @map("storage_key")
  malwareScanStatus String?   @map("malware_scan_status") // PENDING, CLEAN, INFECTED, ERROR
  createdById       String    @map("created_by_id") // see Project.createdById comment re: not a relation
  createdAt         DateTime  @default(now()) @map("created_at")
  releasedById      String?   @map("released_by_id")
  releasedAt        DateTime? @map("released_at")
  validFrom         DateTime  @default(now()) @map("valid_from")
  validUntil        DateTime? @map("valid_until")
  priorRevisionId   String?   @map("prior_revision_id")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  version           Int       @default(1)

  organization  Organization          @relation(fields: [organizationId], references: [id])
  document      Document              @relation(fields: [documentId], references: [id])
  priorRevision DocumentRevision?     @relation("DocumentRevisionHistory", fields: [priorRevisionId], references: [id])
  supersededBy  DocumentRevision[]    @relation("DocumentRevisionHistory")
  approvals     DocumentApproval[]
  stepBindings  StepDocumentBinding[]

  @@unique([organizationId, documentId, revisionNumber])
  @@index([organizationId])
  @@index([documentId, status])
  @@map("document_revisions")
}

model DocumentApproval {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  documentRevisionId String    @map("document_revision_id")
  approverId         String    @map("approver_id")
  approvalStatus     String    @default("PENDING") @map("approval_status") // PENDING, APPROVED, REJECTED
  reason             String?
  approvedAt         DateTime? @map("approved_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  version            Int       @default(1)

  organization     Organization     @relation(fields: [organizationId], references: [id])
  documentRevision DocumentRevision @relation(fields: [documentRevisionId], references: [id])
  approver         User             @relation(fields: [approverId], references: [id])

  @@index([organizationId])
  @@index([documentRevisionId])
  @@map("document_approvals")
}

// ─────────────────────────────────────────────────────────────
// Production Planning (Phase 2)
// ─────────────────────────────────────────────────────────────

model ProductionPlan {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  projectId      String   @map("project_id")
  productId      String   @map("product_id")
  planNumber     String   @map("plan_number")
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  version        Int      @default(1)

  organization Organization             @relation(fields: [organizationId], references: [id])
  project      Project                  @relation(fields: [projectId], references: [id])
  product      Product                  @relation(fields: [productId], references: [id])
  revisions    ProductionPlanRevision[]

  @@unique([organizationId, planNumber])
  @@index([organizationId])
  @@index([projectId])
  @@map("production_plans")
}

// Status machine: DRAFT → IN_REVIEW → APPROVED → RELEASED → SUPERSEDED. Plan
// graphs are validated for cycles before RELEASED — see
// src/domain/production-plans/validate-plan-graph.ts and Negativtest #15.
model ProductionPlanRevision {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  productionPlanId String    @map("production_plan_id")
  revisionNumber   String    @map("revision_number")
  status           String    @default("DRAFT")
  description      String?
  changeReason     String?   @map("change_reason")
  createdById      String    @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  releasedById     String?   @map("released_by_id")
  releasedAt       DateTime? @map("released_at")
  priorRevisionId  String?   @map("prior_revision_id")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  version          Int       @default(1)

  organization     Organization             @relation(fields: [organizationId], references: [id])
  productionPlan   ProductionPlan           @relation(fields: [productionPlanId], references: [id])
  priorRevision    ProductionPlanRevision?  @relation("PlanRevisionHistory", fields: [priorRevisionId], references: [id])
  supersededBy     ProductionPlanRevision[] @relation("PlanRevisionHistory")
  steps            PlanStep[]
  productionOrders ProductionOrder[]

  @@unique([organizationId, productionPlanId, revisionNumber])
  @@index([organizationId])
  @@index([productionPlanId, status])
  @@map("production_plan_revisions")
}

model PlanStep {
  id                       String   @id @default(uuid())
  organizationId           String   @map("organization_id")
  productionPlanRevisionId String   @map("production_plan_revision_id")
  stepNumber               Int      @map("step_number")
  title                    String
  description              String?
  instruction              String?
  departmentId             String?  @map("department_id")
  workCenterId             String?  @map("work_center_id")
  requiredRole             String?  @map("required_role")
  estimatedDurationMinutes Int?     @map("estimated_duration_minutes")
  photoRequired            Boolean  @default(false) @map("photo_required")
  signatureRequired        Boolean  @default(true) @map("signature_required")
  fourEyesRequired         Boolean  @default(false) @map("four_eyes_required")
  fourEyesScope            String?  @map("four_eyes_scope") // EXECUTION_AND_REVIEW, REVIEW_ONLY
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")
  version                  Int      @default(1)

  organization           Organization           @relation(fields: [organizationId], references: [id])
  productionPlanRevision ProductionPlanRevision @relation(fields: [productionPlanRevisionId], references: [id])
  department             Department?            @relation(fields: [departmentId], references: [id])
  workCenter             WorkCenter?            @relation(fields: [workCenterId], references: [id])

  // Naming is deliberately explicit about direction, not "dependents"/
  // "predecessors" (which reads ambiguously — is a "predecessors" array MY
  // predecessors, or edges where I'm predecessor-to-someone-else? A real
  // bug shipped from that ambiguity once already, see git history).
  // predecessorLinks: edges where I am the dependent — read predecessorStepId
  // off these to find what precedes me.
  predecessorLinks          PlanStepDependency[]       @relation("DependentStep")
  // successorLinks: edges where I am the predecessor — read dependentStepId
  // off these to find what comes after me.
  successorLinks            PlanStepDependency[]       @relation("PredecessorStep")
  documentBindings          StepDocumentBinding[]
  checklistItems            ChecklistItem[]
  inspectionCharacteristics InspectionCharacteristic[]
  photoRequirements         PhotoRequirement[]
  workStepInstances         WorkStepInstance[]

  @@unique([organizationId, productionPlanRevisionId, stepNumber])
  @@index([organizationId])
  @@index([productionPlanRevisionId])
  @@map("plan_steps")
}

model PlanStepDependency {
  id                String   @id @default(uuid())
  organizationId    String   @map("organization_id")
  dependentStepId   String   @map("dependent_step_id")
  predecessorStepId String   @map("predecessor_step_id")
  dependencyType    String   @default("FINISH_TO_START") @map("dependency_type")
  lagMinutes        Int      @default(0) @map("lag_minutes")
  createdAt         DateTime @default(now()) @map("created_at")

  organization    Organization @relation(fields: [organizationId], references: [id])
  dependentStep   PlanStep     @relation("DependentStep", fields: [dependentStepId], references: [id])
  predecessorStep PlanStep     @relation("PredecessorStep", fields: [predecessorStepId], references: [id])

  @@unique([organizationId, dependentStepId, predecessorStepId])
  @@index([organizationId])
  @@map("plan_step_dependencies")
}

// Binds a plan step to a specific, pinned document revision (never "latest")
// — see Geschäftsgrundsatz 6 and docs/07_WIREFLOWS_UX.md. Region/page are
// optional pointers into the document for the viewer to highlight.
model StepDocumentBinding {
  id                 String   @id @default(uuid())
  organizationId     String   @map("organization_id")
  planStepId         String   @map("plan_step_id")
  documentId         String   @map("document_id")
  documentRevisionId String   @map("document_revision_id")
  pageNumber         Int?     @map("page_number")
  regionX            Float?   @map("region_x")
  regionY            Float?   @map("region_y")
  regionWidth        Float?   @map("region_width")
  regionHeight       Float?   @map("region_height")
  markerLabel        String?  @map("marker_label")
  createdAt          DateTime @default(now()) @map("created_at")

  organization     Organization     @relation(fields: [organizationId], references: [id])
  planStep         PlanStep         @relation(fields: [planStepId], references: [id])
  document         Document         @relation(fields: [documentId], references: [id])
  documentRevision DocumentRevision @relation(fields: [documentRevisionId], references: [id])

  @@index([organizationId])
  @@index([planStepId])
  @@map("step_document_bindings")
}

// Deliberately minimal for Phase 2 (freeform per-step checklist items).
// Reusable checklist_templates, inspection_characteristics (measurement
// tolerances) and photo_requirements (category/min/max counts) are richer,
// reusable-template concepts that belong to Phase 3/4 (Execution/Quality) —
// see docs/10_MVP_PLAN.md. Not silently dropped: tracked there.
model ChecklistItem {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  planStepId     String   @map("plan_step_id")
  itemNumber     Int      @map("item_number")
  text           String
  isRequired     Boolean  @default(true) @map("is_required")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  version        Int      @default(1)

  organization Organization        @relation(fields: [organizationId], references: [id])
  planStep     PlanStep            @relation(fields: [planStepId], references: [id])
  responses    ChecklistResponse[]

  @@unique([organizationId, planStepId, itemNumber])
  @@index([organizationId])
  @@map("checklist_items")
}

// A measurable characteristic a step must record, with its tolerance band —
// the definition side of docs/07 wireflow A4 ("Sollwert 2.0 mm, Toleranz
// 1.8–2.2 mm"). Deliberately part of the plan revision (via PlanStep), not
// of the execution instance: the tolerance that applied is whatever the
// released plan said, and stays pinned even if the plan is later revised.
model InspectionCharacteristic {
  id                         String   @id @default(uuid())
  organizationId             String   @map("organization_id")
  planStepId                 String   @map("plan_step_id")
  characteristicNumber       Int      @map("characteristic_number")
  name                       String
  nominalValue               Decimal? @map("nominal_value") @db.Decimal(20, 6)
  lowerLimit                 Decimal? @map("lower_limit") @db.Decimal(20, 6)
  upperLimit                 Decimal? @map("upper_limit") @db.Decimal(20, 6)
  unit                       String?
  isRequired                 Boolean  @default(true) @map("is_required")
  // Phase 4 (Qualität) adds `measuring_equipment` + `calibrations` and turns
  // this into a hard gate ("abgelaufenes Prüfmittel → Freigabe abgelehnt",
  // Negativtest #11). Until then the executing worker records the equipment
  // identifier as free text on the measurement result.
  requiresMeasuringEquipment Boolean  @default(false) @map("requires_measuring_equipment")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")
  version                    Int      @default(1)

  organization Organization        @relation(fields: [organizationId], references: [id])
  planStep     PlanStep            @relation(fields: [planStepId], references: [id])
  results      MeasurementResult[]

  @@unique([organizationId, planStepId, characteristicNumber])
  @@index([organizationId])
  @@map("inspection_characteristics")
}

// Per-category photo obligation of a step (docs/07 B3: "📷 Foto Pflicht
// (min 2, max 5)"). PlanStep.photoRequired remains the coarse switch: true
// with no PhotoRequirement rows means "at least one photo, any category" —
// see evaluateStepRequirements() in src/domain/execution/step-requirements.ts,
// which is the single place both meanings are resolved.
model PhotoRequirement {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  planStepId     String   @map("plan_step_id")
  category       String // 'OVERVIEW', 'DETAIL', 'TYPESIGN', custom
  description    String?
  minCount       Int      @default(1) @map("min_count")
  maxCount       Int?     @map("max_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  version        Int      @default(1)

  organization Organization    @relation(fields: [organizationId], references: [id])
  planStep     PlanStep        @relation(fields: [planStepId], references: [id])
  evidence     PhotoEvidence[]

  @@unique([organizationId, planStepId, category])
  @@index([organizationId])
  @@map("photo_requirements")
}

// ─────────────────────────────────────────────────────────────
// Production Execution (Phase 3)
// ─────────────────────────────────────────────────────────────

// Status machine: DRAFT → PLANNED → RELEASED → IN_PROGRESS → COMPLETED,
// with ON_HOLD/QUALITY_BLOCKED/CANCELLED/ARCHIVED — see
// docs/03_STATE_MACHINES.md §1 and src/domain/production-orders/production-order-status.ts.
// productionPlanRevisionId pins the order to ONE plan revision at release
// time; a later plan revision never silently re-writes a running order
// (Geschäftsgrundsatz 6, Abnahmeszenario C).
model ProductionOrder {
  id                       String    @id @default(uuid())
  organizationId           String    @map("organization_id")
  siteId                   String    @map("site_id")
  projectId                String    @map("project_id")
  productId                String    @map("product_id")
  productionPlanRevisionId String    @map("production_plan_revision_id")
  orderNumber              String    @map("order_number")
  batchNumber              String?   @map("batch_number")
  serialNumber             String?   @map("serial_number")
  quantity                 Int       @default(1)
  status                   String    @default("DRAFT")
  plannedStartAt           DateTime? @map("planned_start_at")
  plannedEndAt             DateTime? @map("planned_end_at")
  actualStartAt            DateTime? @map("actual_start_at")
  actualEndAt              DateTime? @map("actual_end_at")
  createdById              String    @map("created_by_id") // see Project.createdById comment re: not a relation
  releasedById             String?   @map("released_by_id")
  releasedAt               DateTime? @map("released_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  version                  Int       @default(1)

  organization           Organization           @relation(fields: [organizationId], references: [id])
  site                   Site                   @relation(fields: [siteId], references: [id])
  project                Project                @relation(fields: [projectId], references: [id])
  product                Product                @relation(fields: [productId], references: [id])
  productionPlanRevision ProductionPlanRevision @relation(fields: [productionPlanRevisionId], references: [id])

  assignments       OrderAssignment[]
  workStepInstances WorkStepInstance[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, serialNumber])
  @@map("production_orders")
}

// The ABAC edge that makes "Worker sieht nur zugewiesene Aufträge"
// (docs/04 "ABAC-Kontextregeln") enforceable server-side. Referenced by
// assertOrderVisibility()/assertAssignedToOrder() in
// src/domain/production-orders/order-access.ts — never only by the UI.
model OrderAssignment {
  id                String    @id @default(uuid())
  organizationId    String    @map("organization_id")
  productionOrderId String    @map("production_order_id")
  userId            String    @map("user_id")
  role              String? // free-text label, e.g. 'EXECUTOR' — RBAC still comes from user_roles
  assignedById      String    @map("assigned_by_id")
  assignedAt        DateTime  @default(now()) @map("assigned_at")
  revokedAt         DateTime? @map("revoked_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  organization    Organization    @relation(fields: [organizationId], references: [id])
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id])
  user            User            @relation(fields: [userId], references: [id])

  @@unique([organizationId, productionOrderId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("order_assignments")
}

// The concrete execution of one plan step within one order. Status is
// SERVER-owned: no client may write COMPLETED (docs/06 "Die zentrale
// Invariante"). See src/domain/execution/work-step-status.ts for the
// machine and src/domain/execution/complete-work-step.ts for the only code
// path that may set COMPLETED.
model WorkStepInstance {
  id                String    @id @default(uuid())
  organizationId    String    @map("organization_id")
  productionOrderId String    @map("production_order_id")
  planStepId        String    @map("plan_step_id")
  stepNumber        Int       @map("step_number") // denormalized from PlanStep for stable ordering/display
  status            String    @default("LOCKED")
  startedById       String?   @map("started_by_id")
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  version           Int       @default(1)

  organization    Organization    @relation(fields: [organizationId], references: [id])
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id])
  planStep        PlanStep        @relation(fields: [planStepId], references: [id])

  release              WorkStepRelease?
  completionSubmission CompletionSubmission?
  secondApproval       SecondApproval?
  confirmations        StepConfirmation[]
  checklistResponses   ChecklistResponse[]
  measurementResults   MeasurementResult[]
  photoEvidence        PhotoEvidence[]

  @@unique([organizationId, productionOrderId, planStepId])
  @@index([organizationId])
  @@index([productionOrderId, status])
  @@map("work_step_instances")
}

// Server-side record of an issued release token. The token itself is only
// ever held by the client; the server keeps its hash plus the nonce so a
// release can be revoked and so a replayed/forged token is detectable
// (docs/06 "Release Token – Design", Negativtest #2). One row per instance:
// releasing step N never implies anything about step N+1.
model WorkStepRelease {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  workStepInstanceId String    @unique @map("work_step_instance_id")
  releasedById       String    @map("released_by_id")
  releasedAt         DateTime  @default(now()) @map("released_at")
  tokenHash          String    @map("token_hash") // SHA-256 of the signature handed to the client
  tokenNonce         String    @map("token_nonce")
  validUntil         DateTime? @map("valid_until")
  planRevisionHash   String    @map("plan_revision_hash")
  documentSetHash    String    @map("document_set_hash")
  requirementsHash   String    @map("requirements_hash")
  isValid            Boolean   @default(true) @map("is_valid")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  version            Int       @default(1)

  organization     Organization     @relation(fields: [organizationId], references: [id])
  workStepInstance WorkStepInstance @relation(fields: [workStepInstanceId], references: [id])

  @@unique([organizationId, tokenNonce])
  @@index([organizationId])
  @@map("work_step_releases")
}

// The client's request to complete a step. Created in PENDING_VALIDATION and
// only ever moved to VALIDATED/REJECTED by the server. idempotencyKey makes
// a repeated submission return the original outcome instead of completing
// twice (docs/05 "Idempotency Key", Negativtest #3).
model CompletionSubmission {
  id                      String    @id @default(uuid())
  organizationId          String    @map("organization_id")
  workStepInstanceId      String    @unique @map("work_step_instance_id")
  idempotencyKey          String    @map("idempotency_key")
  submittedById           String    @map("submitted_by_id")
  submittedAt             DateTime  @map("submitted_at")
  clientCompletedAt       DateTime? @map("client_completed_at")
  deviceId                String?   @map("device_id")
  status                  String    @default("PENDING_VALIDATION") // PENDING_VALIDATION, VALIDATED, REJECTED
  validationStatus        String?   @map("validation_status") // OK, MISSING_REQUIRED_EVIDENCE, MEASUREMENT_OUT_OF_TOLERANCE, ...
  validationReason        String?   @map("validation_reason")
  validatedAt             DateTime? @map("validated_at")
  validatedById           String?   @map("validated_by_id")
  usedPlanRevisionId      String    @map("used_plan_revision_id")
  usedDocumentRevisionIds Json?     @map("used_document_revision_ids")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  version                 Int       @default(1)

  organization     Organization     @relation(fields: [organizationId], references: [id])
  workStepInstance WorkStepInstance @relation(fields: [workStepInstanceId], references: [id])

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@map("completion_submissions")
}

// The human confirmation ("Ich bestätige, dass ich den Arbeitsschritt ...",
// docs/07 A5). signatureData holds a non-reversible digest binding actor,
// step, confirmation text and time — never the PIN, which is verified
// against User.confirmationPinHash and then discarded.
model StepConfirmation {
  id                      String   @id @default(uuid())
  organizationId          String   @map("organization_id")
  workStepInstanceId      String   @map("work_step_instance_id")
  confirmedById           String   @map("confirmed_by_id")
  confirmationText        String   @map("confirmation_text")
  confirmationTextVersion String   @map("confirmation_text_version")
  signatureMethod         String   @map("signature_method") // PIN, DIGITAL_SIGNATURE
  signatureData           String   @map("signature_data")
  deviceId                String?  @map("device_id")
  confirmedAt             DateTime @map("confirmed_at")
  createdAt               DateTime @default(now()) @map("created_at")
  version                 Int      @default(1)

  organization     Organization     @relation(fields: [organizationId], references: [id])
  workStepInstance WorkStepInstance @relation(fields: [workStepInstanceId], references: [id])

  @@index([organizationId])
  @@index([workStepInstanceId])
  @@map("step_confirmations")
}

model ChecklistResponse {
  id                 String   @id @default(uuid())
  organizationId     String   @map("organization_id")
  workStepInstanceId String   @map("work_step_instance_id")
  checklistItemId    String   @map("checklist_item_id")
  response           String // OK, NOK, N/A
  comment            String?
  respondedById      String   @map("responded_by_id")
  respondedAt        DateTime @map("responded_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  version            Int      @default(1)

  organization     Organization     @relation(fields: [organizationId], references: [id])
  workStepInstance WorkStepInstance @relation(fields: [workStepInstanceId], references: [id])
  checklistItem    ChecklistItem    @relation(fields: [checklistItemId], references: [id])

  // One answer per item per instance — a correction overwrites the answer
  // (the audit trail keeps the previous value, so nothing is lost).
  @@unique([organizationId, workStepInstanceId, checklistItemId])
  @@index([organizationId])
  @@index([workStepInstanceId])
  @@map("checklist_responses")
}

// isWithinTolerance is written by the service but constrained by the
// database: the Phase 3 constraints migration adds a CHECK tying it to
// measured_value vs. the stored limits, so no client and no service can
// persist a measurement that claims to be in tolerance when it is not
// (Negativtest #8). Limits are copied from the InspectionCharacteristic at
// capture time so a later plan revision cannot retroactively change the
// verdict of a measurement already taken.
model MeasurementResult {
  id                         String   @id @default(uuid())
  organizationId             String   @map("organization_id")
  workStepInstanceId         String   @map("work_step_instance_id")
  inspectionCharacteristicId String   @map("inspection_characteristic_id")
  measuredValue              Decimal  @map("measured_value") @db.Decimal(20, 6)
  measuredUnit               String?  @map("measured_unit")
  lowerLimit                 Decimal? @map("lower_limit") @db.Decimal(20, 6)
  upperLimit                 Decimal? @map("upper_limit") @db.Decimal(20, 6)
  isWithinTolerance          Boolean  @default(false) @map("is_within_tolerance")
  measuringEquipmentRef      String?  @map("measuring_equipment_ref")
  measuredById               String   @map("measured_by_id")
  measuredAt                 DateTime @map("measured_at")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")
  version                    Int      @default(1)

  organization             Organization             @relation(fields: [organizationId], references: [id])
  workStepInstance         WorkStepInstance         @relation(fields: [workStepInstanceId], references: [id])
  inspectionCharacteristic InspectionCharacteristic @relation(fields: [inspectionCharacteristicId], references: [id])

  @@unique([organizationId, workStepInstanceId, inspectionCharacteristicId])
  @@index([organizationId])
  @@index([workStepInstanceId])
  @@map("measurement_results")
}

model PhotoEvidence {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  workStepInstanceId String    @map("work_step_instance_id")
  photoRequirementId String?   @map("photo_requirement_id")
  photoCategory      String?   @map("photo_category")
  description        String?
  storageKey         String    @map("storage_key")
  fileHashSha256     String?   @map("file_hash_sha256")
  fileSizeBytes      BigInt?   @map("file_size_bytes")
  mimeType           String?   @map("mime_type")
  malwareScanStatus  String?   @map("malware_scan_status")
  uploadStatus       String    @default("PENDING") @map("upload_status") // PENDING, COMPLETED, FAILED
  takenAt            DateTime? @map("taken_at")
  uploadedAt         DateTime? @map("uploaded_at")
  capturedById       String    @map("captured_by_id")
  deviceId           String?   @map("device_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  version            Int       @default(1)

  organization     Organization      @relation(fields: [organizationId], references: [id])
  workStepInstance WorkStepInstance  @relation(fields: [workStepInstanceId], references: [id])
  photoRequirement PhotoRequirement? @relation(fields: [photoRequirementId], references: [id])

  @@index([organizationId])
  @@index([workStepInstanceId, uploadStatus])
  @@map("photo_evidence")
}

// Created by validateAndCompleteWorkStep when the plan step demands four
// eyes; the deciding service (releaseSecondApproval) is Phase 4 per
// docs/10_MVP_PLAN.md (MVP feature 11 / Abnahmeszenario E). The
// executor ≠ reviewer rule is a DB CHECK constraint, not just app logic —
// see the Phase 3 constraints migration and docs/04 "Vier-Augen-Prinzip".
model SecondApproval {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  workStepInstanceId String    @unique @map("work_step_instance_id")
  executorId         String    @map("executor_id")
  reviewerId         String?   @map("reviewer_id")
  reviewerStatus     String    @default("PENDING") @map("reviewer_status") // PENDING, APPROVED, REJECTED
  reviewerReason     String?   @map("reviewer_reason")
  reviewedAt         DateTime? @map("reviewed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  version            Int       @default(1)

  organization     Organization     @relation(fields: [organizationId], references: [id])
  workStepInstance WorkStepInstance @relation(fields: [workStepInstanceId], references: [id])

  @@index([organizationId])
  @@map("second_approvals")
}
